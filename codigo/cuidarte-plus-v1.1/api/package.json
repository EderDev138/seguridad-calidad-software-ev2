{
  "name": "cuidarte-api",
  "version": "1.1.0",
  "private": true,
  "description": "API REST de Cuidarte+ — gestion de pacientes, examenes medicos y documentos clinicos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:bdd": "cross-env NODE_ENV=test cucumber-js",
    "audit:deps": "npm audit --audit-level=high",
    "mutation": "stryker run",
    "verify": "npm run format && npm run lint && npm run test:cov && npm run test:bdd && npm run audit:deps"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "bcryptjs": "3.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  }
}
