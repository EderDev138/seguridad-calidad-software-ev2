# =====================================================================
# Cuidarte+ API — variables de entorno (NFR-SEG-13)
#
# Copie este archivo como .env y complete los valores. El .env NUNCA se
# versiona: los secretos no deben estar en el repositorio.
#
# Genere los secretos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# --- Servicio ---------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_VERSION=1.1.0
LOG_LEVEL=info

# --- Base de datos (ERS §4.2) ----------------------------------------
# No existe valor por defecto: si falta, el servicio no arranca.
DATABASE_URL=postgresql://cuidarte:CAMBIE_ESTA_CLAVE@localhost:5432/cuidarte
DB_POOL_MAX=20
# TLS hacia la base de datos: obligatorio fuera del QA local (NFR-SEG-1).
DB_SSL=false

# --- Sesion y tokens (RF-1, NFR-SEG-9) -------------------------------
# Minimo 32 caracteres. Deben ser distintos entre si.
JWT_SECRET=GENERE_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_REFRESH_SECRET=GENERE_OTRO_SECRETO_ALEATORIO_DISTINTO_DEL_ANTERIOR
JWT_VIGENCIA_ACCESO=15m
JWT_VIGENCIA_REFRESH=8h

# --- Politica de contrasenas (ERS §2.4, RF-1.4) ----------------------
PASSWORD_LARGO_MINIMO=12
# Factor de costo de bcrypt (NFR-SEG-2). Minimo aceptado: 12.
BCRYPT_COST=12

# --- Proteccion contra fuerza bruta (RF-1.3, NFR-SEG-11) -------------
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15
RATE_LIMIT_AUTH=10
# Limite general por IP. Dimensionado desde NFR-PERF-3: 200 usuarios
# concurrentes x 60 peticiones/min = 12.000, con margen a 15.000.
# Un valor bajo (p. ej. 300) rechaza trafico legitimo cuando todo el
# centro de salud comparte una IP publica.
RATE_LIMIT_GENERAL=15000

# --- Origenes permitidos (CORS) --------------------------------------
CORS_ORIGENES=http://localhost:5173
TRUST_PROXY_HOPS=1

# --- Storage interno de documentos (RF-4.4) --------------------------
STORAGE_DIR=./storage-documentos
