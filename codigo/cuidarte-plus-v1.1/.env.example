# =====================================================================
# Cuidarte+ · Variables del ambiente QA (docker compose)
#
# Copie este archivo como .env y complete los secretos (NFR-SEG-13).
# El archivo .env NO se versiona: esta en .gitignore.
#
# Genere cada secreto con un valor distinto:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# --- Base de datos ----------------------------------------------------
POSTGRES_DB=cuidarte
POSTGRES_USER=cuidarte
POSTGRES_PASSWORD=CAMBIE_ESTA_CLAVE_ANTES_DE_LEVANTAR

# --- Sesion y tokens (RF-1, NFR-SEG-9) -------------------------------
# Minimo 32 caracteres y distintos entre si.
JWT_SECRET=GENERE_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_REFRESH_SECRET=GENERE_OTRO_SECRETO_ALEATORIO_DISTINTO_DEL_ANTERIOR
JWT_VIGENCIA_ACCESO=15m
JWT_VIGENCIA_REFRESH=8h

# --- Politica de contrasenas y criptografia --------------------------
BCRYPT_COST=12
PASSWORD_LARGO_MINIMO=12

# --- Proteccion contra fuerza bruta (RF-1.3, NFR-SEG-11) -------------
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15
RATE_LIMIT_AUTH=10
# Limite general por IP. Dimensionado desde NFR-PERF-3: 200 usuarios
# concurrentes x 60 peticiones/min = 12.000, con margen a 15.000.
# Un valor bajo (p. ej. 300) rechaza trafico legitimo cuando todo el
# centro de salud comparte una IP publica.
RATE_LIMIT_GENERAL=15000

# --- Puertos publicados en el host -----------------------------------
WEB_PUERTO=5173
API_PUERTO=3000
# Solo se usa con el perfil `depuracion`.
DB_PUERTO=5432

# --- Otros ------------------------------------------------------------
APP_VERSION=1.1.0
LOG_LEVEL=info
CORS_ORIGENES=http://localhost:5173
